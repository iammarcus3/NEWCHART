rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny Default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User Profile & subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User Plaques subcollection
      match /plaques/{plaqueId} {
        allow read, write: if isOwner(userId) && isValidId(plaqueId);
      }

      // User Settings subcollection
      match /settings/{settingDocId} {
        allow read, write: if isOwner(userId) && isValidId(settingDocId);
      }

      // User Scrobble Chunks subcollection
      match /scrobble_chunks/{chunkId} {
        allow read, write: if isOwner(userId) && isValidId(chunkId);
      }
    }
  }
}

